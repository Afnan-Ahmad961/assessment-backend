// Database models for the appointments API.
// Tables and columns use snake_case in Postgres (via @@map / @map) and camelCase in TypeScript.
// Constraints Prisma can't express (CHECKs, the no-overlap exclusion constraint) live in the
// migration SQL; see prisma/migrations/*_init/migration.sql.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Auth
// ---------------------------------------------------------------------------

model User {
  // UUIDv7 is time-ordered, so new rows land at the end of the primary key index
  // instead of at random positions (cheaper inserts than random UUIDv4).
  id           String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  // Always stored lowercased by the API, so the unique index is effectively case-insensitive.
  email        String   @unique @db.VarChar(254)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  fullName     String   @map("full_name") @db.VarChar(100)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  refreshTokens RefreshToken[]
  appointments  Appointment[]
  chatSessions  ChatSession[]

  @@map("users")
}

// One row per issued refresh token. Tokens are rotated: using one revokes it and issues a new one.
// Presenting an already-revoked token means it was stolen or replayed, so all of the user's
// tokens get revoked (reuse detection).
model RefreshToken {
  id        String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  // SHA-256 of the raw token. The raw token is only ever held by the client (the BFF cookie).
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Booking
// ---------------------------------------------------------------------------

// What can be booked. Services are deactivated rather than deleted so past appointments keep
// pointing at a real row.
model Service {
  id              String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name            String   @unique @db.VarChar(100)
  description     String?  @db.VarChar(500)
  durationMinutes Int      @map("duration_minutes")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  appointments Appointment[]

  @@map("services")
}

enum AppointmentStatus {
  CONFIRMED
  CANCELLED
  COMPLETED

  @@map("appointment_status")
}

// Where the booking came from. Lets us measure how often the AI flow succeeds vs. the form fallback.
enum BookingSource {
  CHAT
  FORM

  @@map("booking_source")
}

model Appointment {
  id            String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId        String            @map("user_id") @db.Uuid
  serviceId     String            @map("service_id") @db.Uuid
  // Set when the booking was made through the chat; kept even if the session is deleted (SET NULL).
  chatSessionId String?           @map("chat_session_id") @db.Uuid
  // Always UTC (timestamptz). ends_at is copied from the service duration at booking time, so
  // changing a service's duration later doesn't rewrite history.
  startsAt      DateTime          @map("starts_at") @db.Timestamptz(3)
  endsAt        DateTime          @map("ends_at") @db.Timestamptz(3)
  status        AppointmentStatus @default(CONFIRMED)
  source        BookingSource
  notes         String?           @db.VarChar(1000)
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  service     Service      @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  chatSession ChatSession? @relation(fields: [chatSessionId], references: [id], onDelete: SetNull)

  // "My appointments", newest first.
  @@index([userId, startsAt(sort: Desc)])
  @@index([serviceId])
  @@index([chatSessionId])
  @@map("appointments")
}

// ---------------------------------------------------------------------------
// Chat
// ---------------------------------------------------------------------------

enum ChatSessionStatus {
  ACTIVE
  CLOSED

  @@map("chat_session_status")
}

model ChatSession {
  id            String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId        String            @map("user_id") @db.Uuid
  title         String?           @db.VarChar(120)
  status        ChatSessionStatus @default(ACTIVE)
  // Denormalized so the session list can sort by recent activity without scanning messages.
  lastMessageAt DateTime?         @map("last_message_at") @db.Timestamptz(3)
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages     ChatMessage[]
  appointments Appointment[]

  // "My recent conversations".
  @@index([userId, lastMessageAt(sort: Desc)])
  @@map("chat_sessions")
}

enum ChatMessageRole {
  USER
  ASSISTANT

  @@map("chat_message_role")
}

model ChatMessage {
  id        String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  sessionId String          @map("session_id") @db.Uuid
  role      ChatMessageRole
  content   String          @db.Text
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  // Loading a conversation in order, and polling for "messages after X".
  @@index([sessionId, createdAt])
  @@map("chat_messages")
}
