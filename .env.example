# Copy to .env and fill in. Every variable is validated at startup in src/config/env.ts.

NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# Number of reverse proxies in front of the API (e.g. 1 behind Nginx on the VPS).
# Needed so rate limiting sees the real client IP instead of the proxy's.
TRUST_PROXY_HOPS=0

# Same value as BFF_SHARED_SECRET in the frontend. Lets rate limits see the browser IP behind Vercel.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BFF_SHARED_SECRET=

# Postgres (docker-compose.yml reads the POSTGRES_* values)
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=appointments
POSTGRES_PORT=5434
DATABASE_URL=postgresql://app:app@localhost:5434/appointments

# Auth. Generate the secret with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-a-random-string-of-at-least-32-characters
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Timezone the business operates in (IANA name). Opening hours are interpreted in this zone.
BUSINESS_TIMEZONE=UTC

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
