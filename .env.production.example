# Copy to .env.production on the VPS and fill in real values. Used by docker-compose.prod.yml for
# the database, the migration job, and the API. Never commit the real file.

NODE_ENV=production
PORT=4000
LOG_LEVEL=info

# One reverse proxy (Caddy or Nginx) in front of the API.
TRUST_PROXY_HOPS=1

# Postgres. The API reaches it by its service name, `db`, on the compose network.
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_DB=appointments
DATABASE_URL=postgresql://app:change-me-to-a-long-random-password@db:5432/appointments

# Auth. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Same value as BFF_SHARED_SECRET in the Vercel project.
BFF_SHARED_SECRET=

# Timezone the business operates in (IANA name).
BUSINESS_TIMEZONE=UTC

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
